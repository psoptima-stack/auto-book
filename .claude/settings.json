{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "PowerShell(Remove-Item -Recurse -Force:*)",
      "PowerShell(rm -rf:*)",
      "PowerShell(gh repo delete:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -fd:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ],
    "ask": [
      "PowerShell(git push:*)",
      "PowerShell(gh repo create:*)",
      "PowerShell(* --write*)"
    ]
  }
}

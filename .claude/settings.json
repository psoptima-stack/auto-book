{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sec=$(sed -n \"s/.*build_[a-z]*\\.py[[:space:]]\\+\\([0-9A-Za-z_]*\\).*/\\1/p\"); [ -n \"$sec\" ] && ./venv/Scripts/python.exe verify.py \"$sec\" 2>&1 || true",
            "timeout": 300,
            "statusMessage": "빌드 결과 검증 중..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "PowerShell(Remove-Item -Recurse -Force:*)",
      "PowerShell(rm -rf:*)",
      "PowerShell(gh repo delete:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -fd:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ],
    "ask": [
      "PowerShell(git push:*)",
      "PowerShell(gh repo create:*)",
      "PowerShell(* --write*)"
    ]
  }
}
